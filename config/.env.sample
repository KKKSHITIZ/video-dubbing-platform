# Environment-variable overrides for running with zero infrastructure (local dev).
# Export these in your shell (or use the JSON variant in appsettings) before launching.

# --- Persistence: use SQLite so no server is required ---
Database__Provider=Sqlite
ConnectionStrings__Sqlite=Data Source=./videodubbing.db

# --- Queue: None = in-process; NoOpProcessInProcess=true runs the whole pipeline
#      inside the API so a single process is a complete, self-contained demo ---
Messaging__Provider=None
Messaging__NoOpProcessInProcess=true

# --- Storage: local filesystem ---
Storage__Provider=Local
Storage__LocalRoot=./data

# --- AI providers: use local/mock providers, no cloud keys required ---
Providers__SpeechToText__Primary=Mock
Providers__Translation__Primary=Mock
Providers__Voice__Primary=LocalFfmpeg
Providers__Diarization__Primary=FfmpegSilence

# --- Disable rate limiting for local scripting ---
Security__EnableRateLimiting=false
